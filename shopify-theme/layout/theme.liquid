<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {% render 'meta-tags' %}
    {{ content_for_header }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.shopify.com">
    <link href="https://fonts.googleapis.com/css2?family=Tenor+Sans&display=swap" rel="stylesheet">
    {{ 'caelia.css' | asset_url | stylesheet_tag }}
    <style>
      :root {
        --c-berry: {{ settings.color_berry }};
        --c-rosa: {{ settings.color_rosa }};
        --c-crema: {{ settings.color_crema }};
        --c-cacao: {{ settings.color_cacao }};
        --c-ink: {{ settings.color_ink }};
      }
    </style>
    {% render 'jsonld' %}
    <link rel="icon" href="{{ 'favicon.svg' | asset_url }}" type="image/svg+xml">
  </head>
  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" role="main">
      {% render 'breadcrumb' %}
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    <script src="{{ 'caelia.js' | asset_url }}" defer></script>
  </body>
</html>
