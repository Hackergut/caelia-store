<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    {% render 'meta-tags' %}
    {{ content_for_header }}
    <link rel="preconnect" href="https://cdn.shopify.com">
    {{ 'caelia.css' | asset_url | stylesheet_tag }}
    <style>
      @font-face {
        font-family: "Tenor Sans";
        src: url("{{ 'TenorSans.ttf' | asset_url }}") format("truetype");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      {% if settings.type_font != blank and settings.use_tenor == false %}
        {{ settings.type_font | font_face: font_display: 'swap' }}
        :root { --font: {{ settings.type_font.family }}, sans-serif; }
      {% endif %}
      :root {
        --c-berry: {{ settings.color_berry }};
        --c-rosa: {{ settings.color_rosa }};
        --c-crema: {{ settings.color_crema }};
        --c-cacao: {{ settings.color_cacao }};
        --c-ink: {{ settings.color_ink }};
      }
    </style>
    {% render 'jsonld' %}
    {% if settings.favicon %}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}" type="image/png">
    {% else %}
      <link rel="icon" href="{{ 'favicon.svg' | asset_url }}" type="image/svg+xml">
    {% endif %}
    {% if settings.ab_cta %}
    <script>
      (function () {
        try {
          var k = "caelia_cta_ab";
          var v = localStorage.getItem(k);
          if (v !== "A" && v !== "B") {
            v = Math.random() < 0.5 ? "A" : "B";
            localStorage.setItem(k, v);
          }
          document.documentElement.setAttribute("data-cta", v);
        } catch (e) {
          document.documentElement.setAttribute("data-cta", "A");
        }
      })();
    </script>
    <style>
      html[data-cta="B"] [data-cta-a] { display: none !important; }
      html[data-cta="A"] [data-cta-b],
      html:not([data-cta]) [data-cta-b] { display: none !important; }
    </style>
    {% endif %}
  </head>
  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
    <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-cart-status></p>
    {% sections 'header-group' %}
    {% section 'cart-drawer' %}
    <main id="MainContent" role="main" tabindex="-1">
      {% render 'breadcrumb' %}
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    <dialog class="c-qv" data-quick-dialog>
      <button type="button" class="c-qv__close" data-qv-close aria-label="{{ 'general.close' | t }}">{{ 'general.close' | t }}</button>
      <div class="c-qv__body" data-qv-body></div>
    </dialog>
    <script>
      window.CAELIA = {
        drawer: {{ settings.enable_cart_drawer | json }},
        added: {{ 'products.added' | t | json }},
        routes: {
          cartAdd: "{{ routes.cart_add_url }}.js",
          cart: "{{ routes.cart_url }}.js",
          root: "{{ routes.root_url }}",
          search: "{{ routes.search_url }}",
          predictive: "{{ routes.predictive_search_url }}"
        }
      };
    </script>
    <script src="{{ 'caelia.js' | asset_url }}" defer></script>
  </body>
</html>
