{%- if settings.show_breadcrumbs -%}
{%- unless template.name == 'index' -%}
<nav class="c-crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="{{ routes.root_url }}">Home</a></li>
    {%- if template.name == 'product' -%}
      <li><a href="{{ settings.featured_collection.url | default: collections.caelia.url | default: routes.all_products_collection_url }}">Collezione</a></li>
      <li aria-current="page">{{ product.title }}</li>
    {%- elsif template.name == 'collection' -%}
      <li aria-current="page">{{ collection.title }}</li>
    {%- elsif template.name == 'page' -%}
      <li aria-current="page">{{ page.title }}</li>
    {%- elsif template.name == 'cart' -%}
      <li aria-current="page">Carrello</li>
    {%- endif -%}
  </ol>
</nav>
{%- endunless -%}
{%- endif -%}
