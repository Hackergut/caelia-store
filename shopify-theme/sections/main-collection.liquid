<section class="c-row">
  <div class="shell">
    <p class="eyebrow">{{ section.settings.kicker }}</p>
    <h1 class="type-display-md">{{ collection.title | default: section.settings.title }}</h1>
    {% if collection.description != blank %}
      <div class="rte c-row__sub">{{ collection.description }}</div>
    {% endif %}
    {% paginate collection.products by section.settings.per_page %}
      {% render 'facets', collection: collection %}
      <div class="c-row__grid" style="margin-top:2rem">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <p>{{ 'products.empty_collection' | t }}</p>
        {% endfor %}
      </div>
      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_collection.name_0",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.main_collection.kicker.label",
      "default": "Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.main_collection.title.label",
      "default": "Three colours."
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "t:sections.main_collection.per_page.label",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 12
    }
  ]
}
{% endschema %}
