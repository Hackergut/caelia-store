<section class="c-row">
  <div class="shell">
    <p class="eyebrow">{{ section.settings.kicker }}</p>
    <h1 class="type-display-md">{{ collection.title | default: section.settings.title }}</h1>
    {% if collection.description != blank %}
      <div class="rte c-row__sub">{{ collection.description }}</div>
    {% endif %}
    {% paginate collection.products by section.settings.per_page %}
      {% render 'facets', collection: collection %}
      <div class="c-row__grid" style="margin-top:2rem">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <p>{{ 'products.empty_collection' | t }}</p>
        {% endfor %}
      </div>
      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Eyebrow", "default": "Collection" },
    { "type": "text", "id": "title", "label": "Fallback title", "default": "Three colours." },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 3, "max": 24, "step": 3, "default": 12 }
  ]
}
{% endschema %}
