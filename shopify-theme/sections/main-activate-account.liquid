<section class="c-page">
  <div class="shell c-page__box">
    <h1 class="type-display-md">{{ 'customers.activate' | t }}</h1>
    {% form 'activate_customer_password' %}
      {{ form.errors | default_errors }}
      <label class="c-label">{{ 'customers.password' | t }}<input type="password" name="customer[password]" required></label>
      <label class="c-label">{{ 'customers.password_confirm' | t }}<input type="password" name="customer[password_confirmation]" required></label>
      <button class="btn-primary" type="submit">{{ 'customers.save' | t }}</button>
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "t:sections.main_activate_account.name_0"
}
{% endschema %}
