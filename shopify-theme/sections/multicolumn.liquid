<section class="c-row">
  <div class="shell">
    <p class="eyebrow">{{ section.settings.kicker }}</p>
    <h2 class="type-display-md">{{ section.settings.title }}</h2>
    <div class="c-row__grid" style="margin-top:2rem">
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.heading }}
          {% endif %}
          <h3 class="c-card__title">{{ block.settings.heading }}</h3>
          <div class="rte">{{ block.settings.body }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.multicolumn.name_0",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.multicolumn.kicker.label",
      "default": "Why"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.multicolumn.title.label",
      "default": "Made to carry."
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.column.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.image.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.multicolumn.heading.label",
          "default": "Mirror"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "t:sections.multicolumn.body.label",
          "default": "<p>Anti-shatter, leather-framed.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.multicolumn.presets__0.name",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
