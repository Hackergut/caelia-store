<section class="c-split c-split--{{ section.settings.layout }}">
  <div class="c-split__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.title }}
    {% endif %}
  </div>
  <div class="c-split__copy">
    <p class="eyebrow">{{ section.settings.kicker }}</p>
    <h2 class="type-display-md">{{ section.settings.title }}</h2>
    <div class="rte">{{ section.settings.body }}</div>
    {% if section.settings.button_label != blank %}
      <a class="btn-primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.image_with_text.name_0",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image_with_text.image.label"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.image_with_text.kicker.label",
      "default": "Storia"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.image_with_text.title.label",
      "default": "Carla & Giulia"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:sections.image_with_text.body.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.image_with_text.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.image_with_text.button_link.label"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.image_with_text.layout.label",
      "default": "image-left",
      "options": [
        {
          "value": "image-left",
          "label": "t:sections.image_with_text.layout.options__image-left.label"
        },
        {
          "value": "image-right",
          "label": "t:sections.image_with_text.layout.options__image-right.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_with_text.presets__0.name"
    }
  ]
}
{% endschema %}
