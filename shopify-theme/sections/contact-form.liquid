<section class="c-page">
  <div class="shell c-page__box">
    <p class="eyebrow">Contatti</p>
    <h1 class="type-display-md">{{ page.title | default: 'Scrivici' }}</h1>
    {% form 'contact' %}
      {% if form.posted_successfully? %}
        <p role="status">{{ 'contact.posted' | t }}</p>
      {% else %}
        <label class="c-label" for="ContactName">Nome
          <input id="ContactName" type="text" name="contact[nome]" autocomplete="name" required>
        </label>
        <label class="c-label" for="ContactEmail">Email
          <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required>
        </label>
        <label class="c-label" for="ContactBody">Messaggio
          <textarea id="ContactBody" name="contact[body]" rows="5" required></textarea>
        </label>
        <button type="submit" class="btn-primary">{{ 'contact.send' | t }}</button>
      {% endif %}
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "t:sections.contact_form.name_0",
  "presets": [
    {
      "name": "t:sections.contact_form.presets__0.name"
    }
  ]
}
{% endschema %}
