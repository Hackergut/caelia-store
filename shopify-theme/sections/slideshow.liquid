<section class="c-slide" data-slideshow aria-roledescription="carousel">
  {% for block in section.blocks %}
    <article class="c-slide__item{% if forloop.first %} is-on{% endif %}" {{ block.shopify_attributes }}>
      {% if block.settings.image %}
        {% if forloop.first %}
          {{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', alt: block.settings.heading }}
        {% else %}
          {{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', alt: block.settings.heading }}
        {% endif %}
      {% endif %}
      <div class="c-slide__copy">
        {% if block.settings.kicker != blank %}<p class="type-meta">{{ block.settings.kicker }}</p>{% endif %}
        {% if block.settings.heading != blank %}<h2 class="type-display-md">{{ block.settings.heading }}</h2>{% endif %}
        {% if block.settings.button_label != blank %}
          <a class="btn-invert" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>
        {% endif %}
      </div>
    </article>
  {% endfor %}
  {% if section.blocks.size > 1 %}
    <div class="c-slide__nav">
      <button type="button" data-slide-prev aria-label="{{ 'general.prev' | t }}">←</button>
      <button type="button" data-slide-next aria-label="{{ 'general.next' | t }}">→</button>
    </div>
  {% endif %}
</section>
{% schema %}
{
  "name": "t:sections.slideshow.name_0",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.slide.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.slideshow.image.label"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.slideshow.kicker.label",
          "default": "CAELIA"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.slideshow.heading.label",
          "default": "Beauty Mirror Case"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.slideshow.button_label.label",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.slideshow.button_link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.slideshow.presets__0.name",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
