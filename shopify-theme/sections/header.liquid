<header class="c-header c-header--{{ section.settings.layout }}" data-header>
  <a class="c-logo" href="{{ routes.root_url }}" aria-label="{{ 'accessibility.home' | t }}">
    {% if settings.logo %}
      {{ settings.logo | image_url: width: 240 | image_tag: alt: settings.brand_name, class: 'c-logo__img' }}
    {% else %}
      {{ settings.brand_name | default: shop.name }}
    {% endif %}
  </a>
  {% render 'mega-menu', mode: 'desktop', section: section %}
  <div class="c-header__end">
    {% if settings.show_search %}
      <div class="c-header__search">
        <form action="{{ routes.search_url }}" role="search" data-pred-form class="c-header__form">
          <label class="visually-hidden" for="HeaderSearch">{{ 'general.search' | t }}</label>
          <input id="HeaderSearch" class="c-header__input" type="search" name="q" placeholder="{{ 'general.search' | t }}" autocomplete="off" data-pred-input>
        </form>
        {% render 'predictive-search' %}
      </div>
      <a class="type-meta c-header__link" href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>
    {% endif %}
    {% if settings.show_account and shop.customer_accounts_enabled %}
      <a class="type-meta c-header__link" href="{{ routes.account_url }}">{{ 'general.account' | t }}</a>
    {% endif %}
    <a
      class="type-meta c-header__link"
      href="{{ routes.cart_url }}"
      data-cart-toggle
      data-cart-label="{{ 'general.cart' | t }}"
      aria-haspopup="dialog"
      aria-controls="CartDrawer"
      aria-expanded="false"
      aria-label="{{ 'general.cart' | t }}{% if cart.item_count > 0 %}, {{ cart.item_count }}{% endif %}"
    >
      {{ 'general.cart' | t }}
      <span data-cart-count aria-hidden="true">{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</span>
    </a>
    <button type="button" class="c-burger" data-menu-toggle aria-expanded="false" aria-controls="MenuTenda" aria-label="{{ 'general.menu' | t }}">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
<nav id="MenuTenda" class="c-menu" data-menu hidden aria-hidden="true" aria-label="{{ 'general.menu' | t }}">
  <button type="button" class="c-menu__close" data-menu-close aria-label="{{ 'general.close' | t }}">{{ 'general.close' | t }}</button>
  {% render 'mega-menu', mode: 'mobile', section: section %}
  <p class="type-meta c-menu__meta">{{ settings.brand_tagline }}</p>
</nav>
{% for block in section.blocks %}
  {% render block %}
{% endfor %}

{% schema %}
{
  "name": "t:sections.header.name_0",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.header.layout.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.header.layout.options__left.label"
        },
        {
          "value": "center",
          "label": "t:sections.header.layout.options__center.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "mega_image",
      "label": "t:sections.header.mega_image.label"
    },
    {
      "type": "url",
      "id": "mega_link",
      "label": "t:sections.header.mega_link.label"
    },
    {
      "type": "text",
      "id": "mega_caption",
      "label": "t:sections.header.mega_caption.label",
      "default": "The collection"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
