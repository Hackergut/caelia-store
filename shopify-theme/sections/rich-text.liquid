<section class="c-rich" style="background: {{ section.settings.bg }}; color: {{ section.settings.fg }};">
  <div class="shell c-rich__box">
    {% if section.settings.kicker != blank %}<p class="eyebrow">{{ section.settings.kicker }}</p>{% endif %}
    {% if section.settings.title != blank %}<h2 class="type-display-md">{{ section.settings.title }}</h2>{% endif %}
    {% if section.settings.body != blank %}<div class="rte">{{ section.settings.body }}</div>{% endif %}
    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a class="btn-primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.rich_text.name_0",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.rich_text.kicker.label",
      "default": "CAELIA"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.rich_text.title.label",
      "default": "Specchio, matita, un solo gesto."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:sections.rich_text.body.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.rich_text.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.rich_text.button_link.label"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "t:sections.rich_text.bg.label",
      "default": "#973851"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "t:sections.rich_text.fg.label",
      "default": "#ffddde"
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich_text.presets__0.name"
    }
  ]
}
{% endschema %}
