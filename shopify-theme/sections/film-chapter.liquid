<section class="c-chapter c-chapter--{{ section.settings.tone }}">
  <div class="shell c-chapter__cap">
    <div>
      <p class="type-meta">{{ section.settings.kicker }}</p>
      <h2 class="type-display-md">{{ section.settings.title }}</h2>
    </div>
    <p class="c-chapter__body">{{ section.settings.body }}</p>
  </div>
  <div class="c-chapter__frame" data-parallax>
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', alt: section.settings.title }}
    {% elsif section.settings.fallback != 'none' %}
      <img
        src="{{ section.settings.fallback | asset_url }}"
        alt="{{ section.settings.title }}"
        loading="lazy"
        width="2400"
        height="1600"
      >
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.film_chapter.name_0",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.film_chapter.kicker.label",
      "default": "03"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.film_chapter.title.label",
      "default": "Il gesto."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:sections.film_chapter.body.label",
      "default": "Specchio in mano, matite in tasca. Anche in volo."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.film_chapter.image.label"
    },
    {
      "type": "select",
      "id": "fallback",
      "label": "t:sections.film_chapter.fallback.label",
      "default": "life-plane.jpg",
      "options": [
        {
          "value": "life-plane.jpg",
          "label": "t:sections.film_chapter.fallback.options__life-plane.jpg.label"
        },
        {
          "value": "lifestyle-trio.jpg",
          "label": "t:sections.film_chapter.fallback.options__lifestyle-trio.jpg.label"
        },
        {
          "value": "life-apply.jpg",
          "label": "t:sections.film_chapter.fallback.options__life-apply.jpg.label"
        },
        {
          "value": "pair-berry.jpg",
          "label": "t:sections.film_chapter.fallback.options__pair-berry.jpg.label"
        },
        {
          "value": "none",
          "label": "t:sections.film_chapter.fallback.options__none.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "tone",
      "label": "t:sections.film_chapter.tone.label",
      "default": "berry",
      "options": [
        {
          "value": "berry",
          "label": "t:sections.film_chapter.tone.options__berry.label"
        },
        {
          "value": "rosa",
          "label": "t:sections.film_chapter.tone.options__rosa.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.film_chapter.presets__0.name",
      "settings": {
        "kicker": "03",
        "title": "Il gesto.",
        "body": "Specchio in mano, matite in tasca. Anche in volo.",
        "fallback": "life-plane.jpg",
        "tone": "berry"
      }
    },
    {
      "name": "t:sections.film_chapter.presets__1.name",
      "settings": {
        "kicker": "04",
        "title": "Tutto intorno.",
        "body": "I tre colori, insieme. Peonie, vanity, lo stesso gesto.",
        "fallback": "lifestyle-trio.jpg",
        "tone": "rosa"
      }
    }
  ]
}
{% endschema %}
