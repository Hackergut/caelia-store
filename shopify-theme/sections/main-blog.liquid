<section class="c-row">
  <div class="shell">
    <p class="eyebrow">{{ blog.title }}</p>
    <h1 class="type-display-md">{{ section.settings.title | default: blog.title }}</h1>
    {% paginate blog.articles by section.settings.per_page %}
      <div class="c-row__grid" style="margin-top:2rem">
        {% for article in blog.articles %}
          <a class="c-card" href="{{ article.url }}">
            <div class="c-card__frame">
              {% if article.image %}
                {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: article.title }}
              {% else %}
                <div class="c-card__frame--ph" aria-hidden="true"></div>
              {% endif %}
            </div>
            <p class="type-meta">{{ article.published_at | date: '%d %b %Y' }}{% if article.author %} · {{ article.author }}{% endif %}</p>
            <p class="c-card__title">{{ article.title }}</p>
            {% if article.excerpt != blank %}<p class="c-row__sub">{{ article.excerpt | strip_html | truncate: 140 }}</p>{% endif %}
          </a>
        {% else %}
          <p>{{ 'blog.empty' | t }}</p>
        {% endfor %}
      </div>
      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  </div>
</section>
{% schema %}
{
  "name": "t:sections.main_blog.name_0",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.main_blog.title.label",
      "default": "Journal"
    },
    {
      "type": "range",
      "id": "per_page",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6,
      "label": "t:sections.main_blog.per_page.label"
    }
  ]
}
{% endschema %}
