<section class="c-row" data-recs data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=complementary">
  <div class="shell">
    <p class="eyebrow">{{ section.settings.kicker }}</p>
    <h2 class="type-display-md">{{ section.settings.title }}</h2>
    <div class="c-row__grid" style="margin-top:2rem">
      {% if recommendations.performed and recommendations.products_count > 0 %}
        {% for product in recommendations.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.complementary_products.name_0",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.complementary_products.paragraph.content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.complementary_products.kicker.label",
      "default": "Pair with"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.complementary_products.title.label",
      "default": "Complete the set"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.complementary_products.limit.label"
    }
  ]
}
{% endschema %}
