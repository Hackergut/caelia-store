<section class="c-cart">
  <div class="shell c-cart__box">
    <h1 class="type-display-md">{{ 'cart.title' | t }}</h1>
    {% if cart.item_count == 0 %}
      <p class="c-cart__empty">{{ 'cart.empty' | t }}</p>
      <a class="btn-primary" href="{{ settings.featured_collection.url | default: routes.collections_url }}">{{ 'cart.collection' | t }}</a>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post">
        {% for item in cart.items %}
          <div class="c-cart__line">
            {{ item.image | image_url: width: 240 | image_tag: alt: item.title }}
            <div class="c-cart__info">
              <p class="c-card__title">{{ item.product.title }}</p>
              {% if item.selling_plan_allocation %}
                <p class="type-meta">{{ item.selling_plan_allocation.selling_plan.name }}</p>
              {% endif %}
              <p class="type-meta">{{ item.final_line_price | money }}</p>
              {% if item.unit_price_measurement %}
                <p class="c-price__unit type-meta">{{ item.unit_price | money }}/{{ item.unit_price_measurement.reference_unit }}</p>
              {% endif %}
              {% for discount in item.line_level_discount_allocations %}
                <p class="type-meta">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</p>
              {% endfor %}
              <div class="c-qty">
                <input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.quantity' | t }}">
                <a class="type-meta" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
              </div>
            </div>
          </div>
        {% endfor %}
        {% for discount in cart.cart_level_discount_applications %}
          <p class="type-meta">{{ discount.title }} (−{{ discount.total_allocated_amount | money }})</p>
        {% endfor %}
        <div class="c-cart__tot">
          <span class="type-meta">{{ 'cart.total' | t }}</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        {% if settings.cart_note != blank %}
          <p class="c-cart__empty">{{ settings.cart_note }}</p>
        {% endif %}
        <div class="c-cart__actions">
          <button type="submit" name="update" class="btn-ghost">{{ 'cart.update' | t }}</button>
          <button type="submit" name="checkout" class="btn-primary">{{ settings.cart_checkout_label | default: 'Checkout' }}</button>
        </div>
        {{ content_for_additional_checkout_buttons }}
        {% render 'payment-icons' %}
      </form>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_cart.name_0",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main_cart.paragraph.content"
    }
  ]
}
{% endschema %}
