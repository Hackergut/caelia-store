{% if section.settings.text != blank %}
  <div class="c-announce" style="background: {{ section.settings.bg }}; color: {{ section.settings.fg }};">
    <p>{{ section.settings.text }}</p>
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}">{{ section.settings.link_label | default: '→' }}</a>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Barra annuncio",
  "settings": [
    { "type": "text", "id": "text", "label": "Testo", "default": "Spedizione gratuita in Italia oltre 60 €" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Etichetta link", "default": "Collezione" },
    { "type": "color", "id": "bg", "label": "Sfondo", "default": "#4a0e16" },
    { "type": "color", "id": "fg", "label": "Testo", "default": "#ffddde" }
  ]
}
{% endschema %}
