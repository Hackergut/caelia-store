{% if section.settings.text != blank %}
  <div class="c-announce" role="region" aria-label="{{ 'accessibility.announcement' | t }}" style="background: {{ section.settings.bg }}; color: {{ section.settings.fg }};">
    <p>{{ section.settings.text }}</p>
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}">{{ section.settings.link_label | default: '→' }}</a>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "t:sections.announcement_bar.name_0",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.announcement_bar.text.label",
      "default": "Spedizione gratuita in Italia oltre 60 €"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.announcement_bar.link.label"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.announcement_bar.link_label.label",
      "default": "Collezione"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "t:sections.announcement_bar.bg.label",
      "default": "#4a0e16"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "t:sections.announcement_bar.fg.label",
      "default": "#ffddde"
    }
  ]
}
{% endschema %}
