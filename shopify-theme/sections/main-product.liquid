<section class="c-product" data-product>
  <div class="shell c-product__grid">
    <div>
      {% assign feat = product.selected_or_first_available_variant.featured_image | default: product.featured_image %}
      <div class="c-product__stage" data-zoom>
        {% if feat %}
          {{ feat | image_url: width: 2000 | image_tag: class: 'c-product__img', id: 'ProductImage', alt: product.title, loading: 'eager', fetchpriority: 'high' }}
        {% endif %}
      </div>
      {% if product.images.size > 1 %}
        <div class="c-product__thumbs">
          {% for image in product.images %}
            {% assign thumb_alt = image.alt | default: product.title %}
            <button type="button" class="c-product__thumb{% if image == feat %} is-on{% endif %}" data-thumb="{{ image | image_url: width: 1600 }}" aria-label="{{ 'accessibility.show_image' | t: title: thumb_alt }}" aria-pressed="{% if image == feat %}true{% else %}false{% endif %}">
              {{ image | image_url: width: 240 | image_tag: alt: thumb_alt, loading: 'lazy' }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div>
      <p class="eyebrow">{{ product.type | default: 'Beauty Mirror Case' }}</p>
      <h1 class="type-display-md">{{ product.title }}</h1>
      {% if settings.show_vendor and product.vendor != blank %}
        <p class="type-meta">{{ product.vendor }}</p>
      {% endif %}
      {% if settings.show_sku and product.selected_or_first_available_variant.sku != blank %}
        <p class="type-meta">SKU {{ product.selected_or_first_available_variant.sku }}</p>
      {% endif %}
      {% render 'price', product: product, variant: product.selected_or_first_available_variant %}
      <div class="rte c-product__desc">{{ product.description }}</div>
      {% render 'buy-buttons', product: product %}

      {% for block in section.blocks %}
        {% case block.type %}
          {% when '@app' %}
            {% render block %}
          {% when 'collapsible' %}
            <details class="c-fold" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="rte">{{ block.settings.content }}</div>
            </details>
        {% endcase %}
      {% endfor %}

      {% if settings.show_share %}
        <p class="c-share">
          <a href="https://www.facebook.com/sharer.php?u={{ canonical_url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook — {{ 'accessibility.new_window' | t }}">Facebook</a>
          <a href="https://pinterest.com/pin/create/button/?url={{ canonical_url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest — {{ 'accessibility.new_window' | t }}">Pinterest</a>
          <a href="https://wa.me/?text={{ product.title | url_encode }}%20{{ canonical_url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp — {{ 'accessibility.new_window' | t }}">WhatsApp</a>
        </p>
      {% endif %}
      {% if product.metafields.custom.features %}
        <ul class="c-features">
          {% for f in product.metafields.custom.features.value %}
            <li>{{ f }}</li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if collections['caelia'] %}
        <p class="eyebrow" style="margin-top:3rem">{{ 'products.other_colors' | t }}</p>
        <div class="c-alts">
          {% for p in collections['caelia'].products %}
            {% unless p.handle == product.handle %}
              <a href="{{ p.url }}">
                {{ p.featured_image | image_url: width: 400 | image_tag: alt: p.title, loading: 'lazy' }}
                <span class="type-meta">{{ p.title }}</span>
              </a>
            {% endunless %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Gallery, variants, Shop Pay, pickup and selling plans. Extra rows below are blocks — including app blocks." }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Free shipping in Italy over 60 €. 14-day returns.</p>" }
      ]
    }
  ]
}
{% endschema %}
