<section class="c-page">
  <div class="shell c-page__box">
    <h1 class="type-display-md">{{ 'customers.register' | t }}</h1>
    {% form 'create_customer' %}
      {{ form.errors | default_errors }}
      <label class="c-label">{{ 'customers.first_name' | t }}<input type="text" name="customer[first_name]" autocomplete="given-name"></label>
      <label class="c-label">{{ 'customers.last_name' | t }}<input type="text" name="customer[last_name]" autocomplete="family-name"></label>
      <label class="c-label">{{ 'newsletter.email' | t }}<input type="email" name="customer[email]" autocomplete="email" required></label>
      <label class="c-label">{{ 'customers.password' | t }}<input type="password" name="customer[password]" autocomplete="new-password" required></label>
      <button class="btn-primary" type="submit">{{ 'customers.create' | t }}</button>
    {% endform %}
    <p style="margin-top:1.5rem"><a class="type-meta" href="{{ routes.account_login_url }}">{{ 'customers.login' | t }}</a></p>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.main_register.name_0"
}
{% endschema %}
