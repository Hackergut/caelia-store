<section class="c-page" style="min-height:100svh;display:flex;align-items:center">
  <div class="shell c-page__box">
    {% if settings.logo %}
      {{ settings.logo | image_url: width: 240 | image_tag: alt: shop.name, class: 'c-logo__img' }}
    {% else %}
      <p class="c-logo">{{ shop.name }}</p>
    {% endif %}
    <h1 class="type-display-md">{{ section.settings.title }}</h1>
    {% if shop.password_message != blank %}
      <p class="c-row__sub">{{ shop.password_message }}</p>
    {% endif %}
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <label class="c-label">{{ 'password.label' | t }}
        <input type="password" name="password" autocomplete="current-password">
      </label>
      <button class="btn-primary" type="submit">{{ 'password.submit' | t }}</button>
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Soon." }
  ]
}
{% endschema %}
