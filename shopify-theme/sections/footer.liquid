<footer class="c-footer" role="contentinfo">
  <div class="shell">
    <div class="c-footer__grid">
      <div>
        <a class="c-logo" href="{{ routes.root_url }}" aria-label="{{ 'accessibility.home' | t }}">{{ settings.brand_name | default: shop.name }}</a>
        <p class="c-footer__blurb">{{ section.settings.blurb }}</p>
        {% render 'social-icons' %}
      </div>
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }}>
          {% case block.type %}
            {% when '@app' %}
              {% render block %}
            {% when 'menu' %}
              <p class="type-meta">{{ block.settings.heading }}</p>
              <ul class="c-footer__nav">
                {% assign col_menu = linklists[block.settings.menu] %}
                {% if col_menu and col_menu.links.size > 0 %}
                  {% for link in col_menu.links %}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% endfor %}
                {% else %}
                  {% assign fmenu = linklists[settings.footer_menu] %}
                  {% for link in fmenu.links %}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% endfor %}
                {% endif %}
              </ul>
            {% when 'text' %}
              <p class="type-meta">{{ block.settings.heading }}</p>
              <div class="rte">{{ block.settings.body }}</div>
            {% when 'newsletter' %}
              <p class="type-meta">{{ block.settings.heading }}</p>
              {% form 'customer', class: 'c-news__form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="FooterEmail-{{ block.id }}">{{ 'newsletter.email' | t }}</label>
                <input id="FooterEmail-{{ block.id }}" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required>
                <button class="btn-primary" type="submit">{{ 'newsletter.subscribe' | t }}</button>
              {% endform %}
          {% endcase %}
        </div>
      {% endfor %}
    </div>
    {% if section.settings.show_policies %}
      <ul class="c-footer__policies">
        {% if shop.shipping_policy != blank %}<li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>{% endif %}
        {% if shop.refund_policy != blank %}<li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>{% endif %}
        {% if shop.privacy_policy != blank %}<li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>{% endif %}
        {% if shop.terms_of_service != blank %}<li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>{% endif %}
      </ul>
    {% endif %}
    <div class="c-footer__pay">
      {% render 'payment-icons' %}
      {% render 'localization', unique: 'footer' %}
      {% if shop.features.follow_on_shop? %}
        <div class="shopify-follow-on-shop">{{ shop | login_button: action: 'follow' }}</div>
      {% endif %}
    </div>
    <p class="type-meta c-footer__copy">{{ section.settings.text }} · © {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name_0",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.footer.text.label",
      "default": "Milano · Beauty Essentials"
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "t:sections.footer.blurb.label",
      "default": "Beauty Mirror Case. Pelle, specchio, tasca."
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "t:sections.footer.show_policies.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "menu",
      "name": "t:sections.footer.menu.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.heading.label",
          "default": "Maison"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.menu.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.text.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.heading.label",
          "default": "Service"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "t:sections.footer.body.label",
          "default": "<p>Spedizione 2–4 giorni. Reso 14 giorni.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.newsletter.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.heading.label",
          "default": "The list"
        }
      ]
    }
  ]
}
{% endschema %}
