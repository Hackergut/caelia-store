<section class="c-row c-count" data-countdown="{{ section.settings.end }}">
  <div class="shell">
    <p class="eyebrow">{{ section.settings.kicker }}</p>
    <h2 class="type-display-md">{{ section.settings.title }}</h2>
    <p class="c-count__grid" data-count-out>
      <span><b data-d>0</b> {{ 'general.days' | t }}</span>
      <span><b data-h>0</b> {{ 'general.hours' | t }}</span>
      <span><b data-m>0</b> {{ 'general.minutes' | t }}</span>
    </p>
    {% if section.settings.button_label != blank %}
      <a class="btn-primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "t:sections.countdown.name_0",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.countdown.kicker.label",
      "default": "Drop"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.countdown.title.label",
      "default": "Until the next colour."
    },
    {
      "type": "text",
      "id": "end",
      "label": "t:sections.countdown.end.label",
      "default": "2026-12-31"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.countdown.button_label.label",
      "default": "Notify me"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.countdown.button_link.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.countdown.presets__0.name"
    }
  ]
}
{% endschema %}
