<section class="c-row">
  <div class="shell c-faq">
    <p class="eyebrow">{{ section.settings.kicker }}</p>
    <h2 class="type-display-md">{{ section.settings.title }}</h2>
    <div class="c-faq__list">
      {% for block in section.blocks %}
        {% if block.type == '@app' %}
          {% render block %}
        {% else %}
          <details class="c-fold" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.q }}</summary>
            <div class="rte">{{ block.settings.a }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.faq.name_0",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.faq.kicker.label",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.faq.title.label",
      "default": "Questions."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "item",
      "name": "t:sections.faq.item.name",
      "settings": [
        {
          "type": "text",
          "id": "q",
          "label": "t:sections.faq.q.label",
          "default": "How long is shipping?"
        },
        {
          "type": "richtext",
          "id": "a",
          "label": "t:sections.faq.a.label",
          "default": "<p>2–4 days in Italy.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.presets__0.name",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "q": "Is the mirror glass?",
            "a": "<p>Anti-shatter surface, leather-framed on all four sides.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "q": "How many pencils?",
            "a": "<p>The front pocket holds up to five.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
