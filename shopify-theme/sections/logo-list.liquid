<section class="c-row c-logos">
  <div class="shell">
    <p class="eyebrow">{{ section.settings.kicker }}</p>
    <div class="c-logos__row">
      {% for block in section.blocks %}
        <div class="c-logos__item" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.alt }}
          {% else %}
            <span class="type-meta">{{ block.settings.alt }}</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.logo_list.name_0",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.logo_list.kicker.label",
      "default": "As seen in"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.logo_list.logo.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.logo_list.image.label"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "t:sections.logo_list.alt.label",
          "default": "Press"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.logo_list.presets__0.name",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
