<section class="c-row">
  <div class="shell">
    <p class="eyebrow">{{ section.settings.kicker }}</p>
    <h2 class="type-display-md">{{ section.settings.title }}</h2>
    <div class="c-quotes">
      {% for block in section.blocks %}
        <blockquote class="c-quote" {{ block.shopify_attributes }}>
          <p>{{ block.settings.quote }}</p>
          <cite class="type-meta">{{ block.settings.author }}</cite>
        </blockquote>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.testimonials.name_0",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.testimonials.kicker.label",
      "default": "Press"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.testimonials.title.label",
      "default": "In their words."
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "t:sections.testimonials.quote.name",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:sections.testimonials.quote.label",
          "default": "The case I actually carry."
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:sections.testimonials.author.label",
          "default": "Vogue Italia"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.presets__0.name",
      "blocks": [
        {
          "type": "quote"
        },
        {
          "type": "quote",
          "settings": {
            "quote": "Small, precise, beautiful.",
            "author": "Elle"
          }
        }
      ]
    }
  ]
}
{% endschema %}
