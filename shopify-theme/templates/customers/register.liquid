<section class="c-page">
  <div class="shell c-page__box">
    <h1 class="type-display-md">Account</h1>
    {% form 'create_customer' %}
      <label class="c-label">Nome<input type="text" name="customer[first_name]"></label>
      <label class="c-label">Email<input type="email" name="customer[email]" required></label>
      <label class="c-label">Password<input type="password" name="customer[password]" required></label>
      <button class="btn-primary" type="submit">Crea</button>
    {% endform %}
  </div>
</section>
