{% layout none %}
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'caelia.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="c-page" style="min-height:100svh;display:flex;align-items:center">
    <div class="shell c-page__box">
      <p class="c-logo">CAELIA</p>
      <h1 class="type-display-md">Presto.</h1>
      {% form 'storefront_password' %}
        <label class="c-label">Password<input type="password" name="password"></label>
        <button class="btn-primary" type="submit">Entra</button>
      {% endform %}
    </div>
  </body>
</html>
